{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "APCS｜00 控制中心",
      "detail": "APCS 日常學習、複習、筆記與 Git 操作入口",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/apcs_control.py",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "APCS｜01 編譯並執行 C++",
      "detail": "Ctrl+Shift+B｜儲存、編譯並執行 Fast Test Suite；有測資時開啟 Test Center",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/vscode_task.py",
        "build-run",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "APCS｜02 只編譯 C++",
      "detail": "只檢查目前 C++ 是否能成功編譯，不執行",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/vscode_task.py",
        "build",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
