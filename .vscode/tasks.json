{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "APCS: Build current C++",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p \"${workspaceFolder}/build\" && g++ -std=c++17 -O2 -Wall -Wextra \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "APCS: Build & Run current C++",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "\"${workspaceFolder}/build/${fileBasenameNoExtension}\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "APCS: Build current C++"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": false,
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "APCS: Today",
      "type": "shell",
      "command": "python3 tools/apcs.py today",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Validate",
      "type": "shell",
      "command": "python3 tools/apcs.py validate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Sync dashboard",
      "type": "shell",
      "command": "python3 tools/apcs.py sync",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Finish problem",
      "type": "shell",
      "command": "python3 tools/apcs.py finish ${input:apcsProblemId} ${input:apcsScore}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Review problem",
      "type": "shell",
      "command": "python3 tools/apcs.py review ${input:apcsProblemId} ${input:apcsScore}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Create local note",
      "type": "shell",
      "command": "python3 tools/apcs.py note ${input:apcsProblemId}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "apcsProblemId",
      "type": "promptString",
      "description": "APCS problem ID（例如 b130）"
    },
    {
      "id": "apcsScore",
      "type": "pickString",
      "description": "Recall score",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "default": "2"
    }
  ]
}
