{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe 建置使用中檔案",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/utf-8",
        "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "silent",
        "clear": true,
        "close": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "偵錯工具產生的工作。"
    },
    {
      "label": "APCS: Today",
      "type": "shell",
      "command": "python tools/apcs.py today",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Validate",
      "type": "shell",
      "command": "python tools/apcs.py validate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Sync dashboard",
      "type": "shell",
      "command": "python tools/apcs.py sync",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Finish problem",
      "type": "shell",
      "command": "python tools/apcs.py finish ${input:apcsProblemId} ${input:apcsScore}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Review problem",
      "type": "shell",
      "command": "python tools/apcs.py review ${input:apcsProblemId} ${input:apcsScore}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "APCS: Create local note",
      "type": "shell",
      "command": "python tools/apcs.py note ${input:apcsProblemId}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "apcsProblemId",
      "type": "promptString",
      "description": "APCS problem ID (例如 b130)"
    },
    {
      "id": "apcsScore",
      "type": "pickString",
      "description": "Recall score",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "default": "2"
    }
  ]
}
