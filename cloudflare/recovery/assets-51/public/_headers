/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/workspace*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors https://app.notion.com https://www.notion.so https://*.notion.so https://*.notion.site

/labs/*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors https://app.notion.com https://www.notion.so https://*.notion.so https://*.notion.site

/assets/*
  Cache-Control: public, max-age=3600

/visuals/*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors https://app.notion.com https://www.notion.so https://*.notion.so https://*.notion.site
